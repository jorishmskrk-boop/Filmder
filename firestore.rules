rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidRoomCode(code) {
      return code is string && code.size() == 5 && code.matches('^[A-Z0-9]+$');
    }

    // Main validation function for a Room
    function isValidRoom(data) {
      return data.id is string
        && data.id.size() == 5
        && (data.createdAt is int || data.createdAt is float)
        && data.country is string
        && data.country.size() <= 10
        && data.vibe is string
        && data.vibe.size() <= 100
        && data.providers is list
        && data.providers.size() <= 15
        && (data.movies is list && data.movies.size() <= 50)
        && (data.users is map)
        && (data.swipes is map)
        && (data.matches is list && data.matches.size() <= 50)
        && (data.reactions is map)
        && (data.get('expiresAt', null) == null || data.expiresAt is timestamp)
        && (data.get('superLikes', null) == null || data.superLikes is map);
    }

    // Custom Matcher Room path
    match /artifacts/flixmatch-default-id/public/data/rooms/{roomCode} {
      allow get: if isSignedIn() && isValidRoomCode(roomCode);
      
      // Allow list reads (highly restricted, only with exact filter or just block list completely)
      allow list: if false;

      // Allow create if valid room details and the user is registering themselves in the users dict
      allow create: if isSignedIn()
        && isValidRoomCode(roomCode)
        && isValidRoom(request.resource.data);

      // Allow update if the user is in the room and only edits users, swipes, matches, properties, or reactions
      allow update: if isSignedIn()
        && isValidRoomCode(roomCode)
        && isValidRoom(request.resource.data)
        && (
          // Allow joining
          (request.resource.data.users.keys().hasAll(resource.data.users.keys())
          && request.resource.data.users.keys().size() <= 3)
          ||
          // Allow swiping
          (request.resource.data.swipes.keys().size() <= 3)
          ||
          // Allow reactions
          (request.resource.data.reactions.keys().size() <= 3)
          ||
          // Allow matches additions/deletions
          (request.resource.data.matches.size() <= 50)
          ||
          // Allow superLikes
          (request.resource.data.get('superLikes', null) == null || request.resource.data.superLikes.keys().size() <= 3)
        );

      allow delete: if false; // Rooms are never deleted via client
    }
  }
}
